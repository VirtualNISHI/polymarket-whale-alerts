# Polymarket public APIs require no auth.
# Optional override if you proxy through a custom host:
# POLYMARKET_USER_AGENT=polymarket-whale-alerts/0.1

# Discord
DISCORD_WEBHOOK_URL=

# Reserved for future translation / X-posting integration (Phase 1+).
# Reuse the credentials from the polymarket-smart-money project.
GEMINI_API_KEY=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Runtime
LOG_LEVEL=INFO
DB_PATH=./data/whale_alerts.db
DRY_RUN=false
