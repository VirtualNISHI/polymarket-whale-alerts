# Polymarket public APIs require no auth.
# Optional override if you proxy through a custom host:
# POLYMARKET_USER_AGENT=polymarket-whale-alerts/0.1

# Discord
DISCORD_WEBHOOK_URL=

# Reserved for future translation / X-posting integration (Phase 1+).
# Reuse the credentials from the polymarket-smart-money project.
GEMINI_API_KEY=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Nansen (optional). If unset, on-chain context fields are simply omitted
# from embeds. See https://docs.nansen.ai/getting-started/authentication
# Per Nansen ToS, any embed using this data must include attribution
# ("Powered by Nansen"); the formatter handles that automatically.
NANSEN_API_KEY=
NANSEN_PNL_LOOKBACK_DAYS=180

# Runtime
LOG_LEVEL=INFO
DB_PATH=./data/whale_alerts.db
DRY_RUN=false
